        <mxCell id="n4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;MongoDB como unica fonte do Consolidado&lt;/b&gt;&lt;br&gt;&lt;br&gt;A API busca um unico documento daily_balances pelo indice comercianteId + data. O saldo ja esta calculado; nao ha agregacao nem join no GET.&lt;br&gt;&lt;br&gt;Sem cache distribuido, a solucao evita TTL, invalidacao e defasagem adicional. O RNF de 50 req/s deve ser comprovado por teste de carga; so depois se reavalia outra camada." vertex="1">
          <mxGeometry height="230" width="850" x="1320" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="n4c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;Se o Worker parar&lt;/b&gt;&lt;br&gt;&lt;br&gt;As mensagens ficam esperando no topico (retencao de 7 dias) e sao processadas quando ele voltar.&lt;br&gt;&lt;br&gt;Nesse meio tempo a &lt;b&gt;Lancamentos API continua aceitando lancamentos normalmente&lt;/b&gt; - so o relatorio fica atrasado.&lt;br&gt;&lt;br&gt;&lt;i&gt;Esse e exatamente o requisito nao funcional do desafio.&lt;/i&gt;" vertex="1">
          <mxGeometry height="220" width="700" x="20" y="1080" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
