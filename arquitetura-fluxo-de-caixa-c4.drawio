          </mxCell>
        </object>
        <object placeholders="1" c4Name="4. Soma no saldo do dia" c4Type="Component" c4Technology="MongoDB Driver" c4Description="Credito soma, debito subtrai. Faz upsert no documento (comercianteId, data) de &lt;i&gt;daily_balances&lt;/i&gt; junto com o EventId, na mesma transacao MongoDB.&lt;br&gt;&lt;br&gt;&lt;i&gt;A conta do relatorio ja fica pronta aqui.&lt;/i&gt;" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="a4">
