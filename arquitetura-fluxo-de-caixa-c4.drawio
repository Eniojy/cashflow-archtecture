        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;Decisao de escopo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lancamentos e Consolidado sao dominios separados porque possuem ownership de dados, consistencia e disponibilidade diferentes. A integracao por evento evita que a falha do Consolidado interrompa novos lancamentos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Legenda:&lt;/b&gt; azul escuro = pessoa; tracejado = sistema em escopo; azul interno = dominio/capacidade; cinza = sistema externo. Os dominios nao representam conteineres do nivel 2." vertex="1">
          <mxGeometry height="210" width="300" x="-10" y="780" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
