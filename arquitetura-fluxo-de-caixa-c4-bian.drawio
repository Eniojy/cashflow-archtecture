        <object placeholders="1" c4Name="1. Endpoint POST /lancamentos" c4Type="Component" c4Technology="ASP.NET Core Minimal API" c4Description="Recebe o JSON {tipo, valor, data}, monta um objeto chamado &lt;b&gt;RegistrarLancamentoCommand&lt;/b&gt; e entrega ao MediatR.&lt;br&gt;&lt;br&gt;&lt;i&gt;Nao existe regra de negocio aqui - so a traducao de HTTP para objeto.&lt;/i&gt;" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="s1">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=8;strokeColor=#2086C9;metaEdit=1;spacing=10;spacingTop=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="140" width="540" x="420" y="190" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="2. MediatR (o mediador)" c4Type="Component" c4Technology="MediatR" c4Description="Recebe o Command e resolve, via injecao de dependencia, o IRequestHandler correspondente. O endpoint nao conhece a implementacao do caso de uso." label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="s2">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=8;strokeColor=#2086C9;metaEdit=1;spacing=10;spacingTop=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="140" width="540" x="420" y="380" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="3. Behaviors (os filtros do pipeline)" c4Type="Component" c4Technology="MediatR IPipelineBehavior" c4Description="Behaviors transversais: 1) Validacao; 2) log, metricas e trace; 3) idempotencia por comerciante + Idempotency-Key + hash do payload; 4) transacao. A ordem e testada e nao se repete em cada endpoint." label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="s3">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=8;strokeColor=#2086C9;metaEdit=1;spacing=10;spacingTop=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="200" width="540" x="420" y="570" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="4. RegistrarLancamentoCommandHandler" c4Type="Component" c4Technology="MediatR IRequestHandler" c4Description="O caso de uso propriamente dito. Ele so orquestra: pede o objeto de dominio, manda salvar e manda gravar o aviso.&lt;br&gt;&lt;br&gt;&lt;i&gt;E uma classe pequena, testavel sem HTTP e sem banco.&lt;/i&gt;" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="s4">
