        <object placeholders="1" c4Name="1. Recebe o push do Pub/Sub" c4Type="Component" c4Technology="ASP.NET Core endpoint interno + Pub/Sub push" c4Description="Valida o envelope e transforma o evento versionado em AtualizarSaldoDiarioCommand. O endpoint aceita somente a identidade do Pub/Sub." label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="a1">
