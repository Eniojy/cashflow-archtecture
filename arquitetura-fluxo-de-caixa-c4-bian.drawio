        <object placeholders="1" c4Name="2. MediatR entrega ao handler" c4Type="Component" c4Technology="MediatR" c4Description="Transforma a mensagem em um comando &lt;b&gt;AtualizarSaldoDiario&lt;/b&gt; e chama quem sabe trata-lo. Mesma ideia da pagina anterior." label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="a2">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=8;strokeColor=#2086C9;metaEdit=1;spacing=10;spacingTop=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="130" width="480" x="390" y="390" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="3. Ja processei esta mensagem?" c4Type="Component" c4Technology="EF Core / tabela processed_events" c4Description="O Pub/Sub pode entregar a MESMA mensagem duas vezes. Antes de somar qualquer coisa, o handler procura o &lt;i&gt;EventId&lt;/i&gt; na tabela.&lt;br&gt;&lt;br&gt;&lt;i&gt;Ja esta la? ignora e confirma. Sem isso, o saldo dobraria.&lt;/i&gt;" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="a3">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=8;strokeColor=#2086C9;metaEdit=1;spacing=10;spacingTop=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="160" width="480" x="390" y="580" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="4. Soma no saldo do dia" c4Type="Component" c4Technology="EF Core 10" c4Description="Credito soma, debito subtrai. Um unico UPSERT na linha (comerciante, data) da tabela &lt;i&gt;saldo_diario&lt;/i&gt; - junto com o registro do EventId, na mesma transacao.&lt;br&gt;&lt;br&gt;&lt;i&gt;A conta do relatorio ja fica pronta aqui.&lt;/i&gt;" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="a4">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=left;verticalAlign=top;arcSize=8;strokeColor=#2086C9;metaEdit=1;spacing=10;spacingTop=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="170" width="480" x="390" y="790" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="5. Confirma (2xx) ou solicita retry (erro)" c4Type="Component" c4Technology="HTTP + Pub/Sub retry/dead-letter policy" c4Description="Sucesso: responde 2xx e a entrega e confirmada. Erro: resposta nao-2xx; Pub/Sub tenta novamente com backoff e depois encaminha para a DLQ." label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;[%c4Type%: %c4Technology%]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left&quot;&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="a5">
