        <object placeholders="1" c4Name="Topico lancamento-registrado" c4Type="Container" c4Technology="Pub/Sub" c4Description="" label="&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="f3top">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#1A7FA8;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E5F80;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="120" width="200" x="1310" y="390" as="geometry" />
          </mxCell>
        </object>
        <object placeholders="1" c4Name="Consolidado (Worker + API)" c4Type="Container" c4Technology=".NET 10 LTS, MediatR" c4Description="" label="&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="f3cons">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
            <mxGeometry height="140" width="200" x="1060" y="390" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="f3off" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F2F2F2;strokeColor=#8C8496;fontColor=#8C8496;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Legado desativado&lt;/b&gt;&lt;br&gt;Dados historicos migrados e arquivados. Sincronizador removido." vertex="1">
          <mxGeometry height="90" width="450" x="1060" y="580" as="geometry" />
        </mxCell>
        <mxCell id="f3e1" edge="1" parent="1" source="f3gw" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="f3new">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3e2" edge="1" parent="1" source="f3new" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;;dashed=1;" target="f3top">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3e3" edge="1" parent="1" source="f3top" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;;dashed=1;" target="f3cons">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;Como a transicao e conduzida com seguranca&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;Corte por rota, nao por sistema&lt;/b&gt;: o gateway e o unico ponto de decisao. Comeca com 5% do trafego de um piloto e sobe gradualmente.&lt;br&gt;&amp;#8226; &lt;b&gt;Anti-Corruption Layer&lt;/b&gt;: o Sincronizador traduz o modelo do legado para o contrato de evento da nova plataforma. Nenhum conceito legado vaza para o dominio novo.&lt;br&gt;&amp;#8226; &lt;b&gt;Contrato unico de evento&lt;/b&gt;: o Consolidado ja e escrito uma unica vez e nao muda quando o legado sai do ar.&lt;br&gt;&amp;#8226; &lt;b&gt;Rollback&lt;/b&gt;: reverter o roteamento no gateway devolve o trafego ao legado em segundos, sem deploy.&lt;br&gt;&amp;#8226; &lt;b&gt;Criterio de saida da Fase 2&lt;/b&gt;: 100% do trafego migrado, reconciliacao de saldos sem divergencia por 30 dias consecutivos e historico migrado." vertex="1">
          <mxGeometry height="140" width="1460" x="60" y="920" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="8. Decisoes, RNFs, Seguranca e Custos" id="decisoes">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1750" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t8" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1E4074;" value="Decisoes, RNFs, Seguranca, Observabilidade, Custos e Testes" vertex="1">
          <mxGeometry height="34" width="1300" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t8b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#4D4D4D;" value="Pagina de apoio para a defesa da solucao: o que foi decidido, quais alternativas foram descartadas e por que." vertex="1">
          <mxGeometry height="24" width="1300" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#3162AF;align=left;verticalAlign=top;fontSize=11;fontColor=#12305C;spacing=10;arcSize=4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;1. Requisitos nao funcionais e criterios de aceite&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RNF-1 - Lancamentos nao pode ficar indisponivel se o Consolidado cair.&lt;/b&gt;&lt;br&gt;Deploys e bancos separados; nenhuma chamada sincrona de Lancamentos para Consolidado; Outbox + Pub/Sub retém trabalho pendente. Prova: teste de caos derruba Worker e API de Consolidado enquanto POST /lancamentos continua retornando 201.&lt;br&gt;&lt;br&gt;&lt;b&gt;RNF-2 - 50 req/s no Consolidado, com no maximo 5% de falhas.&lt;/b&gt;&lt;br&gt;Criterio: durante teste sustentado de 15 min, sucesso minimo de 95%, p95 abaixo de 200 ms e zero perda de dado aceito. Read model pre-calculado + indice composto + pool de conexoes + autoscaling. Redis so entra se o teste demonstrar necessidade.&lt;br&gt;&lt;br&gt;&lt;b&gt;Disponibilidade:&lt;/b&gt; alvo 99,9% Lancamentos / 99,5% Consolidado; Cloud SQL HA em producao.&lt;br&gt;&lt;b&gt;Durabilidade:&lt;/b&gt; RPO 0 para lancamento confirmado; outbox na mesma transacao.&lt;br&gt;&lt;b&gt;Consistencia:&lt;/b&gt; forte no registro; eventual no saldo, SLO de lag p95 abaixo de 5 s.&lt;br&gt;&lt;b&gt;Recuperacao:&lt;/b&gt; RTO alvo 30 min; backup + PITR testado trimestralmente." vertex="1">
          <mxGeometry height="350" width="810" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#3162AF;align=left;verticalAlign=top;fontSize=11;fontColor=#12305C;spacing=10;arcSize=4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;2. Decisoes arquiteturais (ADR resumido)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ADR-01 - Dois servicos logicos independentes.&lt;/b&gt;&lt;br&gt;Um unico deploy aumentaria o raio de impacto; uma malha maior de microsservicos nao tem justificativa de dominio. Consolidado usa API + Worker no mesmo bounded context.&lt;br&gt;&lt;br&gt;&lt;b&gt;ADR-02 - Integracao assincrona por evento.&lt;/b&gt;&lt;br&gt;REST sincrono acoplaria disponibilidade e violaria o RNF principal.&lt;br&gt;&lt;br&gt;&lt;b&gt;ADR-03 - Transactional Outbox.&lt;/b&gt;&lt;br&gt;Evita dual-write entre PostgreSQL e Pub/Sub.&lt;br&gt;&lt;br&gt;&lt;b&gt;ADR-04 - CQRS leve + MediatR, sem Event Sourcing.&lt;/b&gt;&lt;br&gt;Commands/Queries e Behaviors organizam o codigo; read model resolve a consulta sem reconstruir estado.&lt;br&gt;&lt;br&gt;&lt;b&gt;ADR-05 - .NET 10 LTS + PostgreSQL + Cloud Run + Pub/Sub.&lt;/b&gt;&lt;br&gt;.NET 10 tem suporte ativo ate 2028; a nuvem segue o padrao observado no desenho Consignado.&lt;br&gt;&lt;br&gt;&lt;b&gt;ADR-06 - Sem Redis no MVP.&lt;/b&gt;&lt;br&gt;50 req/s sobre uma linha indexada e modesto. Cache e evolucao orientada por SLI, nao premissa.&lt;br&gt;&lt;br&gt;&lt;b&gt;ADR-07 - Idempotencia nas duas pontas.&lt;/b&gt;&lt;br&gt;Idempotency-Key + hash na API; EventId no consumidor." vertex="1">
          <mxGeometry height="410" width="790" x="900" y="110" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6F6;strokeColor=#B03A2E;align=left;verticalAlign=top;fontSize=11;fontColor=#6B1D14;spacing=10;arcSize=4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;3. Seguranca para consumo dos servicos&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;AuthN:&lt;/b&gt; OAuth 2.0/OIDC; Authorization Code + PKCE para usuario e Client Credentials para integracao.&lt;br&gt;&amp;#8226; &lt;b&gt;AuthZ:&lt;/b&gt; scopes lancamentos:write/read e consolidado:read; comercianteId vem do claim e e validado contra o recurso (evita IDOR).&lt;br&gt;&amp;#8226; &lt;b&gt;Borda:&lt;/b&gt; TLS 1.2+, WAF, rate limit/quota por client_id, validacao de schema e payload.&lt;br&gt;&amp;#8226; &lt;b&gt;Interno:&lt;/b&gt; ingress restrito; Gateway e Pub/Sub chamam Cloud Run com identidade IAM/OIDC e privilegio minimo. mTLS somente se politica corporativa exigir.&lt;br&gt;&amp;#8226; &lt;b&gt;Dados:&lt;/b&gt; criptografia padrao em transito/repouso; CMEK quando houver requisito; segredos no Secret Manager e rotacao.&lt;br&gt;&amp;#8226; &lt;b&gt;Auditoria:&lt;/b&gt; lancamentos append-only; estorno e novo lancamento; PII mascarada em logs.&lt;br&gt;&amp;#8226; &lt;b&gt;Supply chain:&lt;/b&gt; SAST, SCA, SBOM, scan e assinatura de imagem; deploy apenas de artefato assinado.&lt;br&gt;&amp;#8226; &lt;b&gt;LGPD:&lt;/b&gt; minimizacao, finalidade, retencao e trilha de acesso definidas com negocio/juridico." vertex="1">
          <mxGeometry height="330" width="810" x="60" y="490" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAF5;strokeColor=#2E7D32;align=left;verticalAlign=top;fontSize=11;fontColor=#1E4620;spacing=10;arcSize=4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;4. Observabilidade e operacao&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Padrao:&lt;/b&gt; OpenTelemetry para traces, metricas e logs; Correlation-Id propagado no evento Pub/Sub.&lt;br&gt;&lt;br&gt;&lt;b&gt;SLIs/SLOs&lt;/b&gt;&lt;br&gt;&amp;#8226; disponibilidade e taxa de 5xx por servico;&lt;br&gt;&amp;#8226; p95/p99 de POST e GET;&lt;br&gt;&amp;#8226; lag de consolidacao: 201 ate saldo atualizado, p95 abaixo de 5 s;&lt;br&gt;&amp;#8226; idade da linha mais antiga da outbox;&lt;br&gt;&amp;#8226; backlog/idade da assinatura e mensagens na DLQ.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alertas acionaveis&lt;/b&gt;&lt;br&gt;Outbox &gt; 60 s, DLQ &gt; 0, backlog crescente, divergencia na reconciliacao, erro budget consumido rapidamente e falha de backup/PITR.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dashboards:&lt;/b&gt; RED por servico + painel de negocio; runbooks vinculados a cada alerta." vertex="1">
          <mxGeometry height="370" width="790" x="900" y="550" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBF0;strokeColor=#B85C00;align=left;verticalAlign=top;fontSize=11;fontColor=#6B3800;spacing=10;arcSize=4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;5. Custos - ordem de grandeza GCP (ago/2026)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; Cloud Run: 3 processos; APIs request-based, Lancamentos instance-based por causa do HostedService (min 1): &lt;b&gt;US$ 90-170&lt;/b&gt;&lt;br&gt;&amp;#8226; Cloud SQL PostgreSQL: 2 instancias HA + storage, backup e PITR: &lt;b&gt;US$ 400-550&lt;/b&gt;&lt;br&gt;&amp;#8226; Pub/Sub, Load Balancer/Armor, logs/metricas e egress: &lt;b&gt;US$ 100-150&lt;/b&gt;&lt;br&gt;&lt;b&gt;Total de planejamento: US$ 590-870/mes&lt;/b&gt; em producao. Dev/hml sem HA e com scale-to-zero: aprox. 25-35%. Recalcular por regiao, volume e contratos no Pricing Calculator antes de aprovar.&lt;br&gt;&lt;br&gt;&lt;b&gt;Licencas:&lt;/b&gt; .NET, PostgreSQL e OpenTelemetry nao exigem licenca paga. MediatR v13+ usa chave e licenciamento duplo; validar politica/custo com procurement. Se necessario, trocar por mediator interno preservando Commands, Queries e Behaviors." vertex="1">
          <mxGeometry height="340" width="810" x="60" y="850" as="geometry" />
        </mxCell>
        <mxCell id="p6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#3162AF;align=left;verticalAlign=top;fontSize=11;fontColor=#12305C;spacing=10;arcSize=4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;6. Testes e evolucoes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Piramide de testes&lt;/b&gt;&lt;br&gt;&amp;#8226; unitarios: agregado, handlers e Behaviors;&lt;br&gt;&amp;#8226; integracao: PostgreSQL + Pub/Sub emulator/Testcontainers;&lt;br&gt;&amp;#8226; contrato: JSON Schema/Pact para LancamentoRegistrado.v1;&lt;br&gt;&amp;#8226; carga: k6, 50 req/s por 15 min, sucesso minimo de 95%, p95 abaixo de 200 ms;&lt;br&gt;&amp;#8226; resiliencia: derrubar Consolidado e Pub/Sub, duplicar evento e reprocessar DLQ;&lt;br&gt;&amp;#8226; seguranca: authZ/IDOR, rate limit, SAST/SCA e threat modeling.&lt;br&gt;&lt;br&gt;&lt;b&gt;Evolucoes orientadas por evidencia&lt;/b&gt;&lt;br&gt;Redis se o SLO de leitura falhar; publisher em processo separado se throughput/ownership exigir; ConsolidadoDiarioFechado para Financial Accounting; multi-loja/moeda; DR multi-regiao se RTO/RPO justificar.&lt;br&gt;&lt;br&gt;&lt;i&gt;Nao adotado sem necessidade: Kubernetes proprio, service mesh, Event Sourcing, GraphQL e mais bounded contexts.&lt;/i&gt;" vertex="1">
          <mxGeometry height="310" width="790" x="900" y="950" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>