        <object placeholders="1" c4Type="Relationship" c4Technology="Dapper / TCP" c4Description="SELECT por chave" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left&quot;&gt;[%c4Technology%]&lt;/div&gt;" id="r5">
          <mxCell edge="1" parent="1" source="q3" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="c4db">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="970" y="715" />
                <mxPoint x="970" y="1200" />
                <mxPoint x="1015" y="1200" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="n4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker e API sao processos .NET com deploys separados. Eles nao se chamam; compartilham apenas o banco do bounded context Consolidado.&lt;br&gt;&lt;br&gt;&lt;b&gt;Legenda C4:&lt;/b&gt; azul = componente; tracejado = limite do conteiner; cilindro = dado/topico." vertex="1">
          <mxGeometry height="200" width="260" x="20" y="410" as="geometry" />
        </mxCell>
        <mxCell id="n4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;Decisao pragmatica&lt;/b&gt;&lt;br&gt;&lt;br&gt;O saldo e calculado quando o evento chega, nao quando o relatorio e solicitado. A leitura faz um SELECT indexado de uma linha. Para 50 req/s, Redis seria custo e operacao antes de existir evidencia de necessidade.&lt;br&gt;&lt;br&gt;O gate e um teste de carga: se p95 ou taxa de sucesso nao atenderem o SLO, Redis entra como evolucao sem mudar o contrato da API. Isto e CQRS leve, sem Event Sourcing." vertex="1">
          <mxGeometry height="260" width="730" x="1180" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="n4c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;Se o Worker parar&lt;/b&gt;&lt;br&gt;&lt;br&gt;As mensagens ficam esperando no topico (retencao de 7 dias) e sao processadas quando ele voltar.&lt;br&gt;&lt;br&gt;Nesse meio tempo a &lt;b&gt;Lancamentos API continua aceitando lancamentos normalmente&lt;/b&gt; - so o relatorio fica atrasado.&lt;br&gt;&lt;br&gt;&lt;i&gt;Esse e exatamente o requisito nao funcional do desafio.&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="700" x="20" y="1250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. Dominios e Capacidades (BIAN)" id="bian">
    <mxGraphModel dx="1716" dy="1183" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1E4074;" value="Dominios Funcionais e Capacidades - alinhamento BIAN 14.0" vertex="1">
          <mxGeometry height="34" width="1300" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t5b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#4D4D4D;" value="BIAN e uma referencia para nomear capacidades; nao implica um microsservico por Service Domain nem conformidade automatica com a Semantic API." vertex="1">
          <mxGeometry height="24" width="1400" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E4074;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;arcSize=6;dashed=0;" value="Business Area: Operations &amp; Execution" vertex="1">
          <mxGeometry height="630" width="780" x="60" y="130" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#7DA1D4;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=4;arcSize=6;" value="Business Domain: Account Management" vertex="1">
          <mxGeometry height="290" width="720" x="90" y="180" as="geometry" />
        </mxCell>
        <mxCell id="sd1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;arcSize=10;" value="&lt;b&gt;Position Keeping&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BIAN Service Domain]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Capacidade:&lt;/b&gt; registrar debitos/creditos e manter o log financeiro que origina a posicao.&lt;br&gt;&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt;&lt;br&gt;Lancamentos (API + DB + Outbox)" vertex="1">
          <mxGeometry height="220" width="330" x="115" y="225" as="geometry" />
        </mxCell>
        <mxCell id="sd2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;arcSize=10;" value="&lt;b&gt;Customer Position&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BIAN Service Domain]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Capacidade:&lt;/b&gt; manter e expor a posicao consolidada diaria do comerciante.&lt;br&gt;&lt;br&gt;&lt;b&gt;Bounded context:&lt;/b&gt;&lt;br&gt;Consolidado (Worker + API + DB)" vertex="1">
          <mxGeometry height="220" width="330" x="465" y="225" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#7DA1D4;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=4;arcSize=6;" value="Integracao futura (fora do escopo do desafio)" vertex="1">
          <mxGeometry height="230" width="720" x="90" y="500" as="geometry" />
        </mxCell>
        <mxCell id="sd3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8496;fontColor=#4D4D4D;align=center;verticalAlign=middle;fontSize=11;arcSize=10;dashed=1;" value="&lt;b&gt;Financial Accounting&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BIAN Service Domain]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Recebe, no futuro, o evento ConsolidadoDiarioFechado para contabilizacao no ERP. Nao faz parte do MVP e nao compartilha banco com os contextos da plataforma." vertex="1">
          <mxGeometry height="160" width="680" x="115" y="545" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E4074;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;arcSize=6;dashed=0;" value="BIAN | Business Domain: Cross Channel" vertex="1">
          <mxGeometry height="300" width="480" x="880" y="130" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#7DA1D4;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=4;arcSize=6;" value="Service Domain reutilizado" vertex="1">
          <mxGeometry height="220" width="420" x="910" y="180" as="geometry" />
        </mxCell>
        <mxCell id="sd4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;arcSize=10;" value="&lt;b&gt;Party Authentication&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BIAN Service Domain]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Autenticacao e autorizacao sao fornecidas pelo IdP corporativo (OAuth 2.0/OIDC); a plataforma apenas valida tokens e scopes." vertex="1">
          <mxGeometry height="165" width="370" x="935" y="222" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E4074;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;arcSize=6;dashed=0;" value="BIAN | Business Domain: Customer Management" vertex="1">
          <mxGeometry height="300" width="480" x="880" y="460" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#7DA1D4;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=4;arcSize=6;" value="Service Domain reutilizado" vertex="1">
          <mxGeometry height="220" width="420" x="910" y="510" as="geometry" />
        </mxCell>
        <mxCell id="sd5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;arcSize=10;" value="&lt;b&gt;Party Reference Data Directory&lt;/b&gt;&lt;br&gt;&lt;i&gt;[BIAN Service Domain]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Cadastro mestre do comerciante permanece no dominio corporativo. A plataforma usa o comercianteId do token e nao replica dados cadastrais sem necessidade." vertex="1">
          <mxGeometry height="165" width="370" x="935" y="552" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E4074;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;arcSize=6;dashed=0;" value="Capacidade de plataforma (nao e dominio do produto)" vertex="1">
          <mxGeometry height="300" width="300" x="1400" y="130" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#7DA1D4;fontColor=#1E4074;align=center;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=4;arcSize=6;" value="Operacao corporativa reutilizada" vertex="1">
          <mxGeometry height="220" width="250" x="1425" y="180" as="geometry" />
        </mxCell>
        <mxCell id="sd6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;arcSize=10;" value="&lt;b&gt;Plataforma e Observabilidade&lt;/b&gt;&lt;br&gt;&lt;br&gt;CI/CD, secrets, logs, metricas, traces, backup e recuperacao sao capacidades corporativas reutilizadas, nao um bounded context do fluxo de caixa." vertex="1">
          <mxGeometry height="165" width="210" x="1445" y="222" as="geometry" />
        </mxCell>
        <mxCell id="lg1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#4D4D4D;" value="&lt;b&gt;Legenda&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="200" x="60" y="790" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;strokeColor=#0E7DAD;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;arcSize=10;" value="Construido neste desafio" vertex="1">
          <mxGeometry height="40" width="220" x="60" y="815" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;arcSize=10;" value="Reaproveitado (capacidade existente)" vertex="1">
          <mxGeometry height="40" width="260" x="300" y="815" as="geometry" />
        </mxCell>
        <mxCell id="lg4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8496;fontColor=#4D4D4D;align=center;verticalAlign=middle;fontSize=11;arcSize=10;dashed=1;" value="Fora do escopo / evolucao" vertex="1">
          <mxGeometry height="40" width="220" x="580" y="815" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;Do requisito ao dominio - e por que apenas 2 servicos logicos&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; Controle de lancamentos &amp;#8594; &lt;b&gt;Position Keeping&lt;/b&gt; &amp;#8594; bounded context &lt;b&gt;Lancamentos&lt;/b&gt;.&lt;br&gt;&amp;#8226; Consolidado diario &amp;#8594; &lt;b&gt;Customer Position&lt;/b&gt; &amp;#8594; bounded context &lt;b&gt;Consolidado&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fronteira:&lt;/b&gt; cada contexto e dono de seus dados; a integracao entre contextos e por evento, nunca por banco compartilhado. Worker e API do Consolidado podem compartilhar o banco porque pertencem ao mesmo contexto.&lt;br&gt;&lt;b&gt;Nuance importante:&lt;/b&gt; Service Domain BIAN nao vira automaticamente um deploy. Aqui o mapeamento 1:1 foi escolhido porque coincide com coesao de negocio, ownership de dados e o RNF de isolamento de falha.&lt;br&gt;&lt;b&gt;Escopo:&lt;/b&gt; autenticacao e cadastro sao reutilizados; Financial Accounting fica para evolucao." vertex="1">
          <mxGeometry height="230" width="1640" x="60" y="880" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="6. Fluxo do Sistema" id="fluxo">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1250" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1E4074;" value="Fluxo do Sistema - tecnologias e pontos de resiliencia" vertex="1">
          <mxGeometry height="34" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t6b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#4D4D4D;" value="Dois caminhos independentes: a escrita (azul) e sincrona ate o 201 e assincrona dali para frente; a leitura (verde) so consulta dado ja consolidado." vertex="1">
          <mxGeometry height="24" width="1100" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="ha" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E4074;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;arcSize=8;" value="FLUXO 1 - Registrar um lancamento (escrita)" vertex="1">
          <mxGeometry height="44" width="500" x="60" y="100" as="geometry" />
        </mxCell>
        <mxCell id="a01" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;1. Requisicao&lt;/b&gt;&lt;br&gt;O comerciante envia &lt;b&gt;POST /lancamentos&lt;/b&gt; com {tipo, valor, data} e o header &lt;b&gt;Idempotency-Key&lt;/b&gt;." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="170" as="geometry" />
        </mxCell>
        <mxCell id="a02" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;2. Borda&lt;/b&gt;&lt;br&gt;O API Gateway valida o JWT contra o JWKS do IdP, aplica rate limit e roteia para a Lancamentos API." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="290" as="geometry" />
        </mxCell>
        <mxCell id="a03" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;3. Pipeline do MediatR&lt;/b&gt;&lt;br&gt;Validation &amp;#8594; Logging/Tracing &amp;#8594; Idempotency &amp;#8594; Transaction. Pedido invalido ou retry equivalente termina aqui." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="410" as="geometry" />
        </mxCell>
        <mxCell id="a04" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;4. Regra de negocio&lt;/b&gt;&lt;br&gt;O RegistrarLancamentoCommandHandler cria o agregado Lancamento: valor maior que zero, tipo valido, data nao futura." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="530" as="geometry" />
        </mxCell>
        <mxCell id="a05" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;5. Persistencia atomica (chave da solucao)&lt;/b&gt;&lt;br&gt;Na MESMA transacao: INSERT do lancamento + INSERT do evento LancamentoRegistrado na tabela &lt;b&gt;outbox&lt;/b&gt;." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="650" as="geometry" />
        </mxCell>
        <mxCell id="a06" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;6. Resposta imediata&lt;/b&gt;&lt;br&gt;&lt;b&gt;201 Created&lt;/b&gt; para o comerciante. A resposta NAO depende do servico de Consolidado - aqui o RNF e atendido." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="770" as="geometry" />
        </mxCell>
        <mxCell id="a07" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;7. Publicacao assincrona&lt;/b&gt;&lt;br&gt;O HostedService le a outbox em lotes, publica LancamentoRegistrado.v1 no Pub/Sub e marca como enviado. Falhou? retry com backoff." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="890" as="geometry" />
        </mxCell>
        <mxCell id="a08" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE9F7;strokeColor=#3162AF;fontColor=#12305C;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;8. Projecao do saldo&lt;/b&gt;&lt;br&gt;Pub/Sub faz push para o Consolidado Worker. Ele verifica EventId e faz UPSERT do saldo e do processed_event na mesma transacao." vertex="1">
          <mxGeometry height="90" width="500" x="60" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="ea1" edge="1" parent="1" source="a01" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#3162AF;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="a02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea2" edge="1" parent="1" source="a02" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#3162AF;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="a03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea3" edge="1" parent="1" source="a03" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#3162AF;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="a04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea4" edge="1" parent="1" source="a04" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#3162AF;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="a05">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea5" edge="1" parent="1" source="a05" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#3162AF;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="a06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea6" edge="1" parent="1" source="a06" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#3162AF;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;;dashed=1;strokeColor=#B85C00;" target="a07" value="assincrono a partir daqui">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea7" edge="1" parent="1" source="a07" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#3162AF;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;;dashed=1;strokeColor=#B85C00;" target="a08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;arcSize=8;" value="FLUXO 2 - Consultar o consolidado diario (leitura)" vertex="1">
          <mxGeometry height="44" width="500" x="640" y="100" as="geometry" />
        </mxCell>
        <mxCell id="b01" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F2E4;strokeColor=#4C9A4C;fontColor=#1E4620;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;1. Requisicao&lt;/b&gt;&lt;br&gt;&lt;b&gt;GET /consolidado/{data}&lt;/b&gt; com Bearer token. O comercianteId vem do claim, nunca da URL ou do corpo." vertex="1">
          <mxGeometry height="90" width="500" x="640" y="170" as="geometry" />
        </mxCell>
        <mxCell id="b02" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F2E4;strokeColor=#4C9A4C;fontColor=#1E4620;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;2. Borda&lt;/b&gt;&lt;br&gt;O API Gateway valida o token e o scope &lt;b&gt;consolidado:read&lt;/b&gt;, e aplica o rate limit por cliente." vertex="1">
          <mxGeometry height="90" width="500" x="640" y="290" as="geometry" />
        </mxCell>
        <mxCell id="b03" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F2E4;strokeColor=#4C9A4C;fontColor=#1E4620;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;3. MediatR&lt;/b&gt;&lt;br&gt;O endpoint cria ObterSaldoDiarioQuery; o mediador resolve o QueryHandler e aplica log/trace. Sem cache no MVP." vertex="1">
          <mxGeometry height="90" width="500" x="640" y="410" as="geometry" />
        </mxCell>
        <mxCell id="b04" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F2E4;strokeColor=#4C9A4C;fontColor=#1E4620;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;4. Read model&lt;/b&gt;&lt;br&gt;O QueryHandler usa Dapper para um SELECT parametrizado na tabela saldo_diario pela chave (comerciante, data). Nao ha recalculo na requisicao." vertex="1">
          <mxGeometry height="90" width="500" x="640" y="530" as="geometry" />
        </mxCell>
        <mxCell id="b05" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F2E4;strokeColor=#4C9A4C;fontColor=#1E4620;align=left;verticalAlign=middle;fontSize=12;spacing=8;arcSize=8;" value="&lt;b&gt;5. Resposta&lt;/b&gt;&lt;br&gt;&lt;b&gt;200 OK&lt;/b&gt; com totalCreditos, totalDebitos, saldo e dataHoraUltimaAtualizacao para deixar a consistencia eventual visivel." vertex="1">
          <mxGeometry height="90" width="500" x="640" y="650" as="geometry" />
        </mxCell>
        <mxCell id="eb1" edge="1" parent="1" source="b01" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="b02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2" edge="1" parent="1" source="b02" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="b03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb3" edge="1" parent="1" source="b03" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="b04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb4" edge="1" parent="1" source="b04" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;" target="b05">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E0;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;fontColor=#5A4A00;spacing=8;arcSize=6;" value="&lt;b&gt;E se algo falhar? (roteiro de resiliencia)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;Consolidado fora do ar:&lt;/b&gt; Lancamentos segue respondendo 201; eventos ficam retidos no Pub/Sub e o saldo mostra a ultima atualizacao.&lt;br&gt;&amp;#8226; &lt;b&gt;Pub/Sub indisponivel:&lt;/b&gt; eventos permanecem na Outbox ate o publisher conseguir enviar.&lt;br&gt;&amp;#8226; &lt;b&gt;Evento repetido:&lt;/b&gt; processed_events impede dupla contagem.&lt;br&gt;&amp;#8226; &lt;b&gt;Evento envenenado:&lt;/b&gt; Pub/Sub encaminha para DLQ e gera alarme; reprocessamento e idempotente.&lt;br&gt;&amp;#8226; &lt;b&gt;50 req/s:&lt;/b&gt; teste de carga deve provar taxa de sucesso minima de 95% e p95 abaixo de 200 ms. Cloud Run escala horizontalmente; 429 com Retry-After e reservado para carga acima da capacidade contratada.&lt;br&gt;&amp;#8226; &lt;b&gt;Dados aceitos:&lt;/b&gt; a meta e zero perda permanente; reconciliacao diaria compara lancamentos e saldo." vertex="1">
          <mxGeometry height="310" width="500" x="640" y="790" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
