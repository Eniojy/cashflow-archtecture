        <mxCell id="rq3" edge="1" parent="1" source="q3" style="endArrow=blockThin;html=1;strokeWidth=2;endFill=1;strokeColor=#4C9A4C;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="q4" value="retorna DTO">
